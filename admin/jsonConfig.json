{
  "i18n": true,
  "type": "tabs",
  "items": {
    "general": {
      "type": "panel",
      "label": "Allgemein",
      "items": {
        "rootPath": {
          "type": "text",
          "label": "Basispfad",
          "help": "Standard: 0_userdata.0.Stoerungen",
          "sm": 12
        },
        "notifyActive": {
          "type": "checkbox",
          "label": "Neue Störungen melden",
          "sm": 4
        },
        "notifyAcknowledged": {
          "type": "checkbox",
          "label": "Quittierungen melden",
          "sm": 4
        },
        "notifyCleared": {
          "type": "checkbox",
          "label": "Behobene Störungen melden",
          "sm": 4
        }
      }
    },
    "faultsTab": {
      "type": "panel",
      "label": "Störungen",
      "items": {
        "faultInfo": {
          "type": "staticText",
          "text": "Jede Störung erhält eine eindeutige ID. Die Bedingungen werden im nächsten Reiter über diese ID zugeordnet. Bei UND müssen alle Bedingungen erfüllt sein, bei ODER genügt eine Bedingung.",
          "newLine": true
        },
        "faults": {
          "type": "table",
          "label": "Störungsregeln",
          "showSecondAddAt": 5,
          "showFirstAddOnTop": true,
          "clone": "id",
          "export": true,
          "import": true,
          "uniqueColumns": [
            "id"
          ],
          "useCardFor": [
            "xs",
            "sm"
          ],
          "titleAttribute": "meldetext",
          "items": [
            {
              "type": "checkbox",
              "attr": "enabled",
              "title": "Aktiv",
              "width": "70px",
              "default": true
            },
            {
              "type": "text",
              "attr": "id",
              "title": "Störungs-ID",
              "width": "170px",
              "default": "Neue_Stoerung",
              "validator": "!!data.id"
            },
            {
              "type": "select",
              "attr": "logic",
              "title": "Verknüpfung",
              "width": "120px",
              "default": "AND",
              "options": [
                {
                  "label": "UND",
                  "value": "AND"
                },
                {
                  "label": "ODER",
                  "value": "OR"
                }
              ]
            },
            {
              "type": "text",
              "attr": "meldegruppe",
              "title": "Meldegruppe",
              "width": "160px",
              "default": "Allgemein"
            },
            {
              "type": "text",
              "attr": "melder",
              "title": "Melder",
              "width": "190px"
            },
            {
              "type": "text",
              "attr": "meldetext",
              "title": "Meldetext",
              "width": "320px",
              "validator": "!!data.meldetext"
            }
          ]
        }
      }
    },
    "conditionsTab": {
      "type": "panel",
      "label": "Bedingungen",
      "items": {
        "conditionInfo": {
          "type": "staticText",
          "text": "Ordne jede Bedingung über die Störungs-ID einer Regel zu. Es werden nur die zur gewählten Bedingung passenden Eingabefelder angezeigt. Verzögerung und Kommunikationsüberwachung sind optional. Bei aktivierter Kommunikationsüberwachung wird zusätzlich eine Störung erkannt, wenn der Datenpunkt innerhalb der eingestellten Zeit keine neue Zustandsaktualisierung liefert.",
          "newLine": true
        },
        "conditions": {
          "type": "table",
          "label": "Regelbedingungen",
          "showSecondAddAt": 5,
          "showFirstAddOnTop": true,
          "clone": "id",
          "export": true,
          "import": true,
          "useCardFor": [
            "xs",
            "sm",
            "md"
          ],
          "titleAttribute": "id",
          "items": [
            {
              "type": "checkbox",
              "attr": "enabled",
              "title": "Aktiv",
              "width": "70px",
              "default": true
            },
            {
              "type": "text",
              "attr": "faultId",
              "title": "Störungs-ID",
              "width": "160px",
              "validator": "!!data.faultId",
              "validatorErrorText": "Störungs-ID fehlt",
              "validatorNoSaveOnError": true
            },
            {
              "type": "text",
              "attr": "id",
              "title": "Bedingungs-ID",
              "width": "160px",
              "default": "Bedingung_1",
              "validator": "!!data.id",
              "validatorErrorText": "Bedingungs-ID fehlt",
              "validatorNoSaveOnError": true
            },
            {
              "type": "objectId",
              "attr": "sourceId",
              "title": "Überwachtes Objekt",
              "types": [
                "state"
              ],
              "width": "300px",
              "validator": "!!data.sourceId",
              "validatorErrorText": "Überwachtes Objekt fehlt",
              "validatorNoSaveOnError": true
            },
            {
              "type": "select",
              "attr": "operator",
              "title": "Bedingung",
              "width": "180px",
              "default": "true",
              "options": [
                {
                  "label": "Wert =",
                  "value": "eq"
                },
                {
                  "label": "Wert ≠",
                  "value": "neq"
                },
                {
                  "label": "größer",
                  "value": "gt"
                },
                {
                  "label": "größer oder gleich",
                  "value": "gte"
                },
                {
                  "label": "kleiner",
                  "value": "lt"
                },
                {
                  "label": "kleiner oder gleich",
                  "value": "lte"
                },
                {
                  "label": "zwischen",
                  "value": "between"
                },
                {
                  "label": "außerhalb",
                  "value": "outside"
                },
                {
                  "label": "bool true",
                  "value": "true"
                },
                {
                  "label": "bool false",
                  "value": "false"
                },
                {
                  "label": "String enthält",
                  "value": "contains"
                },
                {
                  "label": "String enthält nicht",
                  "value": "notContains"
                },
                {
                  "label": "Regex",
                  "value": "regex"
                },
                {
                  "label": "Änderung",
                  "value": "change"
                },
                {
                  "label": "Flanke 0 → 1",
                  "value": "rising"
                },
                {
                  "label": "Flanke 1 → 0",
                  "value": "falling"
                }
              ]
            },
            {
              "type": "text",
              "attr": "compareValue",
              "title": "Vergleichswert / Regex",
              "width": "170px",
              "hidden": "!['eq','neq','gt','gte','lt','lte','between','outside','contains','notContains','regex'].includes(data.operator)",
              "validator": "!['eq','neq','gt','gte','lt','lte','between','outside','contains','notContains','regex'].includes(data.operator) || String(data.compareValue ?? '').length > 0",
              "validatorErrorText": "Vergleichswert fehlt",
              "validatorNoSaveOnError": true
            },
            {
              "type": "text",
              "attr": "compareValue2",
              "title": "Zweiter Wert",
              "width": "120px",
              "hidden": "!['between','outside'].includes(data.operator)",
              "validator": "!['between','outside'].includes(data.operator) || String(data.compareValue2 ?? '').length > 0",
              "validatorErrorText": "Zweiter Vergleichswert fehlt",
              "validatorNoSaveOnError": true
            },
            {
              "type": "text",
              "attr": "regexFlags",
              "title": "Regex-Flags",
              "width": "105px",
              "hidden": "data.operator !== 'regex'",
              "placeholder": "z. B. i"
            },
            {
              "type": "number",
              "attr": "durationSec",
              "title": "Verzögerung (s)",
              "width": "135px",
              "min": 0,
              "default": 0,
              "help": "0 = keine Verzögerung"
            },
            {
              "type": "number",
              "attr": "pulseSec",
              "title": "Impulsdauer (s)",
              "width": "135px",
              "min": 1,
              "default": 1,
              "hidden": "!['change','rising','falling'].includes(data.operator)"
            },
            {
              "type": "checkbox",
              "attr": "communicationMonitoring",
              "title": "Kommunikation überwachen",
              "width": "170px",
              "default": false
            },
            {
              "type": "number",
              "attr": "communicationTimeoutSec",
              "title": "Kein Update nach (s)",
              "width": "155px",
              "min": 1,
              "default": 600,
              "hidden": "!data.communicationMonitoring",
              "validator": "!data.communicationMonitoring || Number(data.communicationTimeoutSec) > 0",
              "validatorErrorText": "Timeout muss größer als 0 sein",
              "validatorNoSaveOnError": true
            }
          ],
          "compact": false
        }
      }
    },
    "notifications": {
      "type": "panel",
      "label": "Benachrichtigungen",
      "items": {
        "notificationInfo": {
          "type": "staticText",
          "text": "Die Nachricht enthält Meldegruppe, Melder, Meldetext, Regelverknüpfung sowie alle Auslöser, Bedingungen, aktuellen Werte und Erfüllungszustände.",
          "newLine": true
        },
        "telegramEnabled": {
          "type": "checkbox",
          "label": "Telegram aktivieren",
          "sm": 4
        },
        "telegramInstance": {
          "type": "instance",
          "adapter": "telegram",
          "label": "Telegram-Instanz",
          "sm": 4,
          "hidden": "!data.telegramEnabled"
        },
        "telegramUser": {
          "type": "text",
          "label": "Telegram-Benutzer (optional)",
          "sm": 4,
          "hidden": "!data.telegramEnabled"
        },
        "emailEnabled": {
          "type": "checkbox",
          "label": "E-Mail aktivieren",
          "sm": 4,
          "newLine": true
        },
        "emailInstance": {
          "type": "instance",
          "adapter": "email",
          "label": "E-Mail-Instanz",
          "sm": 4,
          "hidden": "!data.emailEnabled"
        },
        "emailRecipient": {
          "type": "text",
          "label": "E-Mail-Empfänger",
          "sm": 4,
          "hidden": "!data.emailEnabled"
        },
        "emailSubjectPrefix": {
          "type": "text",
          "label": "Betreff-Präfix",
          "sm": 4,
          "newLine": true,
          "hidden": "!data.emailEnabled"
        },
        "testNotification": {
          "type": "sendTo",
          "label": "Testnachricht senden",
          "command": "testNotification",
          "sm": 4,
          "newLine": true
        }
      }
    }
  }
}
